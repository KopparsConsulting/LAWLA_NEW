{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lawla",
  "compatibility_date": "2026-10-15",
  "main": "./worker/index.ts",
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Bara API- och auth-anrop går via Workern; allt annat serveras direkt som statiska filer.
    "run_worker_first": ["/api/*", "/auth/*", "/history/*", "/settings/*", "/share/*", "/delad/*", "/lagen/*"]
  },
  // Versionshistorik, huvudprompt och delningslänkar (D1 i västra Europa). Tabellen skapas automatiskt av Workern. Se docs/DEPLOY.md.
  "d1_databases": [
    { "binding": "DB", "database_name": "lawla-history", "database_id": "c7278c6d-0725-4ff1-acf1-56a94802a5d2" }
  ],
  "vars": {
    "BACKEND_URL": "https://lawla.berge.tech",
    "APP_ORIGIN": "https://lawla.kopparsconsulting.com"
  },
  "routes": [
    { "pattern": "lawla.kopparsconsulting.com", "custom_domain": true }
  ],
  "env": {
    // Testmiljö på workers.dev, utan egen domän: `wrangler deploy --env staging`
    "staging": {
      "name": "lawla-staging",
      "workers_dev": true,
      "routes": [],
      "vars": {
        "BACKEND_URL": "https://lawla.berge.tech",
        "APP_ORIGIN": ""
      },
      // Delar historikdatabas med produktion (samma backend och ärenden).
      "d1_databases": [
        { "binding": "DB", "database_name": "lawla-history", "database_id": "c7278c6d-0725-4ff1-acf1-56a94802a5d2" }
      ]
    }
  }
}
